{
  "functions": {
    "api/seo/product.ts": {
      "includeFiles": "dist/index.html"
    },
    "api/seo/shell.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/product/:handle",
      "destination": "/api/seo/product?handle=:handle"
    },
    {
      "source": "/(cart|wishlist|orders|account|track-order)",
      "destination": "/api/seo/shell?mode=private"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(catalog|new-arrivals|collections|brands|contact|privacy-policy|terms-of-service|shipping-policy|returns-policy)",
      "destination": "/index.html"
    },
    {
      "source": "/collections/:handle",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/seo/shell?mode=notfound"
    }
  ]
}

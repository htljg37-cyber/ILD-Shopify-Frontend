{
  "functions": {
    "api/seo/product.ts": {
      "includeFiles": "dist/index.html"
    },
    "api/seo/shell.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "redirects": [
    {
      "source": "/products/:handle",
      "destination": "/product/:handle",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/catalog",
      "permanent": true
    },
    {
      "source": "/collections/all",
      "destination": "/catalog",
      "permanent": true
    },
    {
      "source": "/policies/contact-information",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/policies/privacy-policy",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/policies/terms-of-service",
      "destination": "/terms-of-service",
      "permanent": true
    },
    {
      "source": "/policies/shipping-policy",
      "destination": "/shipping-policy",
      "permanent": true
    },
    {
      "source": "/policies/refund-policy",
      "destination": "/returns-policy",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/product/:handle",
      "destination": "/api/seo/product?handle=:handle"
    },
    {
      "source": "/(cart|wishlist|orders|account|track-order)",
      "destination": "/api/seo/shell?mode=private"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(catalog|new-arrivals|collections|brands|contact|privacy-policy|terms-of-service|shipping-policy|returns-policy)",
      "destination": "/index.html"
    },
    {
      "source": "/collections/:handle",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/seo/shell?mode=notfound"
    }
  ]
}
